{
  "framework": "vite",
  "buildCommand": "node scripts/generate-favicons.mjs && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.bundle.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/blog-ai-generate.ts": { "maxDuration": 300 },
    "api/maintenance-notifications.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "maintenance-notifications" }]
    },
    "api/[...route].ts": { "maxDuration": 60 },
    "api/blog-page.ts": { "maxDuration": 60 },
    "api/sitemap.ts": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "photo-laleh.ir"
        }
      ],
      "destination": "https://www.photo-laleh.ir/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog", "destination": "/api/blog-page" },
    { "source": "/blog/(.*)", "destination": "/api/blog-page?__blogpath=$1" },
    { "source": "/api/maintenance-notifications", "destination": "/api/maintenance-notifications" },
    { "source": "/api/admin/blog/ai-generate", "destination": "/api/blog-ai-generate" },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route]?__path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
